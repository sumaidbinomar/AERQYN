# Local development only. Copy to .env and choose your own passwords.
# Keep credentials URL-safe when using them in connection URLs later.
POSTGRES_USER=aerqyn
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_DB=aerqyn
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_USER=aerqyn
RABBITMQ_PASSWORD=replace_with_local_broker_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
API_PORT=3000
WORKER_PORT=3001
WEB_PORT=5173
# Host development only; Compose overrides this with http://api:3000.
API_PROXY_TARGET=http://127.0.0.1:3000
# Host development: match the PostgreSQL values above (URL-encode credentials).
# Compose provides its own URL using the postgres service hostname.
DATABASE_URL=postgresql://aerqyn:replace_with_local_database_password@127.0.0.1:5432/aerqyn?schema=public
