{
  "name": "@aerqyn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "db:dev": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate dev",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "predev": "npm run db:generate",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
