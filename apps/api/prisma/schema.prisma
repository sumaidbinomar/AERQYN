generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESEARCHER
  OBSERVER
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique @db.VarChar(254)
  passwordHash String
  role         Role
}

enum MissionStatus {
  DRAFT
  RUNNING
  STOPPED
  COMPLETED
}

model Mission {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(100)
  description String       @default("") @db.VarChar(2000)
  status      MissionStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  settings    Json
  startedAt   DateTime?     @db.Timestamptz(3)
  anomalyJobs AnomalyJob[]
  alerts      Alert[]
  snapshots   TelemetrySnapshot[]
}

model AnomalyJob {
  id            String   @id @default(uuid()) @db.Uuid
  missionId     String   @db.Uuid
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  startedAt     DateTime @db.Timestamptz(3)
  payload       Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  nextPublishAt DateTime @default(now()) @db.Timestamptz(3)
  processedAt   DateTime? @db.Timestamptz(3)
  outcome       String?  @db.VarChar(20)
  notifiedAt    DateTime? @db.Timestamptz(3)
  alerts        Alert[]

  @@index([processedAt, nextPublishAt])
}

model Alert {
  id        String @id @default(uuid()) @db.Uuid
  jobId     String @db.Uuid
  job       AnomalyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  missionId String @db.Uuid
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  startedAt DateTime @db.Timestamptz(3)
  droneId   String @db.VarChar(20)
  type      String @db.VarChar(30)
  message   String @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([jobId, droneId, type])
  @@index([missionId, createdAt, id])
}

model TelemetrySnapshot {
  missionId String @db.Uuid
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  startedAt DateTime @db.Timestamptz(3)
  elapsedMs Int
  frame Json
  @@id([missionId, startedAt, elapsedMs])
}
