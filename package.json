{
  "name": "aerqyn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @aerqyn/web",
    "dev:api": "npm run dev --workspace @aerqyn/api",
    "dev:worker": "npm run dev --workspace @aerqyn/worker",
    "build": "npm run build --workspace @aerqyn/simulation && npm run build --workspaces",
    "typecheck": "npm run build --workspace @aerqyn/simulation && npm run typecheck --workspaces && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build --workspace @aerqyn/simulation && vitest run",
    "test:integration": "npm run build --workspace @aerqyn/simulation && node --env-file-if-exists=.env scripts/test-integration.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
